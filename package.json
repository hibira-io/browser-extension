{
  "name": "@hibira/browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Hibi in your browser: repetitive web chores, one site at a time, with your approval.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "esbuild": "0.24.2",
    "jsdom": "25.0.1",
    "playwright": "1.63.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
